{
  "name": "@matrix-ai/ui",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/lib/index.js",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:demo && pnpm build:library",
    "build:demo": "tsc -b && vite build",
    "build:library": "tsc -p tsconfig.lib.json && vite build --config vite.library.config.ts",
    "test:consumer": "pnpm build:library && node fixtures/library-consumer.mjs",
    "test:nextjs-consumer": "pnpm build:library && pnpm --filter matrix-ai-ui-nextjs-consumer build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tailwindcss": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "^30.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
