# Voice provider selection. Client-visible (Vite requires the VITE_ prefix to
# expose a var to the browser bundle). "web-speech" needs no key and works with
# plain `pnpm dev`; "elevenlabs" requires vercel dev (or a deployment) plus the
# server-only key below.
VITE_VOICE_PROVIDER=web-speech

# Client-visible default voice id (not secret).
VITE_DEFAULT_VOICE_ID=

# Server-only. Read exclusively inside api/voice/*.js -- never prefixed with
# VITE_, so it never reaches the browser bundle. Get one at elevenlabs.io.
# Never commit a real value here.
ELEVENLABS_API_KEY=
