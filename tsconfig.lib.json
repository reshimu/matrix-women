{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist/lib",
    "rootDir": "./src"
  },
  "include": [
    "src/index.ts",
    "src/react.ts",
    "src/scene/**/*.ts",
    "src/renderer/**/*.ts",
    "src/components/Scene.tsx",
    "src/components/SceneFallback.tsx",
    "src/components/SceneWebgl.tsx",
    "src/components/SubjectPortrait.tsx"
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}