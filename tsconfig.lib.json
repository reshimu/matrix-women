{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist/lib",
    "rootDir": "./src"
  },
  "include": ["src/index.ts", "src/scene/**/*.ts", "src/renderer/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}